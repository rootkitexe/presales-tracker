# Copy this file to .env.local and fill in the values.
#   cp .env.local.example .env.local

# Shared password for the /login gate.
APP_PASSWORD=choose-a-shared-password

# Postgres connection string. Locally use the database's PUBLIC url
# (Railway: Postgres service → Variables → DATABASE_PUBLIC_URL).
# On Railway's app service set DATABASE_URL=${{Postgres.DATABASE_URL}} instead.
DATABASE_URL=postgresql://user:password@host:port/railway

# HubSpot private-app token (HubSpot tab + AI search). Optional: HUBSPOT_PORTAL_ID for "Open" links.
HUBSPOT_TOKEN=

# Azure AD app registration (Outlook / Mail.Read). Redirect URI must be
# <NEXTAUTH_URL>/api/auth/callback/azure-ad
AZURE_AD_CLIENT_ID=
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_SECRET=

# Public base URL of the app (used for the OAuth redirect URI).
NEXTAUTH_URL=http://localhost:3000

# OpenRouter (AI assistant on the Dashboard).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
